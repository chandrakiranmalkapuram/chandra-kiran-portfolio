{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chandrakiran-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "CHECK_CHARACTER",
      "service": "argos-check-character"
    }
  ],
  "previews": {
    "services": [
      {
        "binding": "CHECK_CHARACTER",
        "service": "argos-check-character"
      }
    ]
  }
}
